# ==============================================================================
# VoxShield AI — Backend Configuration (.env)
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="VoxShield AI"
API_V1_STR="/api/v1"
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Security & Cryptography
# Generate a secure key in production: openssl rand -hex 32
SECRET_KEY=change-this-in-production-super-secret-hex-key-voxshield-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
# Production (PostgreSQL): postgresql+asyncpg://voxshield:voxshield_secret@localhost:5432/voxshield_db
# Local fallback (SQLite): sqlite+aiosqlite:///./voxshield.db
DATABASE_URL=sqlite+aiosqlite:///./voxshield.db

# Redis (Caching, Rate Limiting & WebSocket Multi-Node Signaling)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# CORS (Comma-separated list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20

# AI Provider Configuration
AI_DETECTOR_PROVIDER=mock
AI_EMBEDDING_PROVIDER=mock
AI_LIVENESS_PROVIDER=mock
AI_MODEL_VERSION="voxguard-neural-v1.0-demo"

# Blockchain Provider Configuration
# Options: mock, evm
BLOCKCHAIN_PROVIDER=mock
BLOCKCHAIN_NETWORK=mock-ledger
EVM_RPC_URL=""
EVM_CONTRACT_ADDRESS=""
EVM_PRIVATE_KEY=""

# Biometric / Audio Privacy
ENABLE_LOCAL_STORAGE_EMBEDDINGS=true
MAX_AUDIO_UPLOAD_SIZE_MB=25
