# VoxShield AI — Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH ENVIRONMENT-SPECIFIC VALUES.
# NEVER COMMIT SECRETS OR REAL CREDENTIALS TO VERSION CONTROL.

# General Configuration
ENVIRONMENT=development
PROJECT_NAME=VoxShield AI
API_V1_STR=/api/v1
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Cryptography & JWT Security
# Generate secure 64-char key in production: openssl rand -hex 32
SECRET_KEY=change-this-in-production-super-secret-hex-key-voxshield-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
# Default: SQLite for lightweight local runs; PostgreSQL for production: postgresql+asyncpg://user:pass@localhost:5432/voxshield
DATABASE_URL=sqlite+aiosqlite:///./voxshield.db

# Redis Caching (Optional)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (Comma-separated list or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=180
AUTH_RATE_LIMIT_PER_MINUTE=30
CHALLENGE_RATE_LIMIT_PER_MINUTE=20
INCIDENT_RATE_LIMIT_PER_MINUTE=30
DEMO_RATE_LIMIT_PER_MINUTE=60
TELEMETRY_RATE_LIMIT_PER_MINUTE=120

# AI Models & Inference Providers
AI_MODE=local
AI_BACKEND=auto
AI_DEVICE=cpu
AI_FALLBACK_MODE=dsp
DEEPFAKE_MODEL_PATH=backend/models/weights/deepfake/aasist-l.onnx
SPEAKER_MODEL_PATH=backend/models/weights/speaker/voxceleb.onnx
LIVENESS_MODEL_PATH=

# Real-Time Telemetry Settings
ANALYSIS_WINDOW_MS=1500
ANALYSIS_INTERVAL_MS=1000
CONFIDENCE_THRESHOLD=0.70
AUTO_TERMINATE_CRITICAL=false
CHALLENGE_TIMEOUT_SECONDS=30

# Blockchain Ledger Configuration
BLOCKCHAIN_PROVIDER=mock
BLOCKCHAIN_NETWORK=mock-ledger
EVM_RPC_URL=
EVM_CONTRACT_ADDRESS=
EVM_PRIVATE_KEY=
